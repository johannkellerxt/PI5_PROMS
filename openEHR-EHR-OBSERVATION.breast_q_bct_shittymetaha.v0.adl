													3|[local::at2033],
													4|[local::at2034]
												}
											}
											ELEMENT[at2035] occurrences matches {0..1} matches {    -- Being able to wear clothing that is more fitted?
												value matches {
													1|[local::at2036],
													2|[local::at2037],
													3|[local::at2038],
													4|[local::at2039]
												}
											}
											ELEMENT[at2040] occurrences matches {0..1} matches {    -- How your lumpectomy breast sits/hangs?
												value matches {
													1|[local::at2041],
													2|[local::at2042],
													3|[local::at2043],
													4|[local::at2044]
												}
											}
											ELEMENT[at2045] occurrences matches {0..1} matches {    -- How smoothly shaped your lumpectomy breast looks?
												value matches {
													1|[local::at2046],
													2|[local::at2047],
													3|[local::at2048],
													4|[local::at2049]
												}
											}
											ELEMENT[at2050] occurrences matches {0..1} matches {    -- The contour (outline) of your lumpectomy breast?
												value matches {
													1|[local::at2051],
													2|[local::at2052],
													3|[local::at2053],
													4|[local::at2054]
												}
											}
											ELEMENT[at2055] occurrences matches {0..1} matches {    -- How equal in size your breasts are to each other?
