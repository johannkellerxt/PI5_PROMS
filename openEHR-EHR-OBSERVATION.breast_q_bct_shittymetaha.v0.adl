	term_definitions = <
		["de"] = <
			items = <
				["at0000"] = <
					text = <"breast_q_bct_shittymetaha">
					description = <"Das BREAST-Q Modul für brusterhaltende Therapie (BCT) ist ein patientenberichtetes Ergebnisinstrument zur Bewertung der Lebensqualität und Zufriedenheit bei Patientinnen nach einer brusterhaltenden Therapie wegen Brustkrebs.">
				>
