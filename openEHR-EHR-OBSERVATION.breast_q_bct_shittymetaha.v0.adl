					description = <"">
				>
				["at9000"] = <
					text = <"Pensando al tuo seno, o se hai avuto una mastectomia, nelle ultima settimana quanto soddisfatta o insoddisfatta ti sei sentita di:">
					description = <"Pensando al tuo seno, o se hai avuto una mastectomia, nelle ultima settimana quanto soddisfatta o insoddisfatta ti sei sentita di:">
				>
				["at9002"] = <
					text = <"Se hai avuto una quadrantectomia con radioterapia su entrambi i seni, rispondi a queste domande pensando al seno per cui ti senti meno soddisfatta. Con il tuo seno in mente, nella scorsa settimana, quanto soddisfatta o insoddisfatta ti sei sentita riguardo a:">
					description = <"Se hai avuto una quadrantectomia con radioterapia su entrambi i seni, rispondi a queste domande pensando al seno per cui ti senti meno soddisfatta. Con il tuo seno in mente, nella scorsa settimana, quanto soddisfatta o insoddisfatta ti sei sentita riguardo a:">
				>
				["at9003"] = <
					text = <"Con il tuo seno in mente, nella scorsa settimana, quanto spesso ti sei sentita:">
					description = <"Con il tuo seno in mente, nella scorsa settimana, quanto spesso ti sei sentita:">
				>
				["at9004"] = <
					text = <"Nell’ultima settimana, quanto spesso hai provato:">
					description = <"Nell’ultima settimana, quanto spesso hai provato:">
				>
				["at9005"] = <
					text = <"Pensando alla tua sessualità dal momento della tua quadrantectomia quanto spesso ti senti:">
					description = <"Pensando alla tua sessualità dal momento della tua quadrantectomia quanto spesso ti senti:">
				>
				["at9006"] = <
					text = <"Quanto sei soddisfatta o insoddisfatta per le informazioni che hai ricevuto dal tuo chirurgo senologo su:">
					description = <"Quanto sei soddisfatta o insoddisfatta per le informazioni che hai ricevuto dal tuo chirurgo senologo su:">
				>
				["at9007"] = <
					text = <"Queste domande riguardano il comportamento del tuo chirurgo senologo. Hai la sensazione che:">
					description = <"Queste domande riguardano il comportamento del tuo chirurgo senologo. Hai la sensazione che:">
				>
				["at9008"] = <
					text = <"Queste domande riguardano i membri dell’equipe medica diversi dal chirurgo. Hai avuto l’impressione che:">
					description = <"Queste domande riguardano i membri dell’equipe medica diversi dal chirurgo. Hai avuto l’impressione che:">
				>
				["at9009"] = <
					text = <"Queste domande riguardano i membri dello studio medico (ad esempio segretarie, infermiere di studio). Hai avuto l’impressione che:">
					description = <"Queste domande riguardano i membri dello studio medico (ad esempio segretarie, infermiere di studio). Hai avuto l’impressione che:">
				>
				["at9010"] = <
					text = <"Se hai fatto radioterapia su entrambi i seni, rispondi a queste domande pensando al seno per cui ti senti meno soddisfatta. Con il tuo seno in mente, nella scorsa settimana, quanto sei stata disturbata da:">
					description = <"Se hai fatto radioterapia su entrambi i seni, rispondi a queste domande pensando al seno per cui ti senti meno soddisfatta. Con il tuo seno in mente, nella scorsa settimana, quanto sei stata disturbata da:">
