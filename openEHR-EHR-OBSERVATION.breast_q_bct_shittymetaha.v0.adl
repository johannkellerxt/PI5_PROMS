description
	original_author = <
		["date"] = <"2026-05-08">
		["name"] = <"Johann Keller">
		["organisation"] = <"x-tention Informationstechnologie AG">
		["email"] = <"johann.keller@x-tention.ch">
	>
	lifecycle_state = <"unmanaged">
	other_contributors = <"Sol Fustinana, University Hospital Basel, Switzerland","Olha Nikolaieva, University Hospital Basel, Switzerland","Maren Diepenbruck, University Hospital Basel, Switzerland">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung der Antworten auf die Items des BREAST-Q Moduls für brusterhaltende Therapie (BCT) und zur Berechnung der entsprechenden patientenberichteten Ergebnisscores.">
			keywords = <"BREAST-Q, BREAST-Q BCT, Brusterhaltende Therapie, Brustkrebs, Patientenberichtetes Ergebnis, Lebensqualität, Brustchirurgie", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Zur Dokumentation patientenberichteter Ergebnisse nach einer brusterhaltenden Therapie verwenden. Das BREAST-Q BCT Modul bewertet Bereiche wie Zufriedenheit mit der Brust, psychosoziales Wohlbefinden, sexuelles Wohlbefinden, körperliches Wohlbefinden und Zufriedenheit mit der Versorgung. Die Scores werden gemäß dem BREAST-Q Bewertungssystem berechnet. Dieses Instrument dient der Lebensqualitätsbewertung und stellt keine klinische Diagnose dar. Diese Darstellung ist unter der Creative Commons Attribution-ShareAlike 4.0 International License lizenziert.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record responses to the BREAST-Q Breast Conserving Therapy (BCT) questionnaire items and calculate the corresponding patient-reported outcome scores.">
			keywords = <"BREAST-Q, BREAST-Q BCT, Breast conserving therapy, Breast cancer, Patient reported outcome, Quality of life, Breast surgery", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Use to document patient-reported outcomes following breast-conserving therapy. The BREAST-Q BCT module evaluates domains including satisfaction with breasts, psychosocial well-being, sexual well-being, physical well-being, and satisfaction with care. Scores are calculated according to the BREAST-Q scoring system. This instrument is a quality-of-life assessment tool and does not establish a clinical diagnosis. This representation is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License.">
		>
		["it"] = <
			language = <[ISO_639-1::it]>
			purpose = <"Registrare le risposte agli item del questionario BREAST-Q Terapia conservativa della mammella (BCT) e calcolare i relativi punteggi degli esiti riferiti dalla paziente.">
			keywords = <"BREAST-Q, BREAST-Q BCT, Terapia conservativa della mammella, Cancro della mammella, Esito riferito dal paziente, Qualità di vita, Chirurgia mammaria", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utilizzare per documentare gli esiti riferiti dalle pazienti dopo terapia conservativa della mammella. Il modulo BREAST-Q BCT valuta domini quali la soddisfazione per la mammella, il benessere psicosociale, il benessere sessuale, il benessere fisico e la soddisfazione per le cure ricevute. I punteggi sono calcolati secondo il sistema di scoring BREAST-Q. Questo strumento è una misura della qualità di vita e non consente di stabilire una diagnosi clinica. Questa rappresentazione è concessa con licenza Creative Commons Attribution-ShareAlike 4.0 International.">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Enregistrer les réponses aux items du questionnaire BREAST-Q Traitement conservateur du sein (BCT) et calculer les scores correspondants des résultats rapportés par les patientes.">
			keywords = <"BREAST-Q, BREAST-Q BCT, Traitement conservateur du sein, Cancer du sein, Résultat rapporté par le patient, Qualité de vie, Chirurgie mammaire", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utiliser pour documenter les résultats rapportés par les patientes après un traitement conservateur du sein. Le module BREAST-Q BCT évalue notamment la satisfaction vis-à-vis des seins, le bien-être psychosocial, le bien-être sexuel, le bien-être physique et la satisfaction à l'égard des soins. Les scores sont calculés selon le système de cotation BREAST-Q. Cet instrument est un outil d'évaluation de la qualité de vie et ne permet pas d'établir un diagnostic clinique. Cette représentation est sous licence Creative Commons Attribution-ShareAlike 4.0 International.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Pusic AL, Klassen AF, Scott AM, Klok JA, Cordeiro PG, Cano SJ. Development of a new patient-reported outcome measure for breast surgery: the BREAST-Q. Plastic and Reconstructive Surgery. 2009;124(2):345-353. doi:10.1097/PRS.0b013e3181aee807.

Memorial Sloan Kettering Cancer Center and University of British Columbia. BREAST-Q Patient Reported Outcome Measure. Breast Conserving Therapy Module.">
		["current_contact"] = <"">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"e5dcead0c5c84f63d267cfe63319b92b">
		["build_uid"] = <"cda9592d-4cf9-41e6-91b5-1e287dc61629">
		["ip_acknowledgements"] = <"The Breast-Q BCT module was developed by the Memorial Sloan Kettering Cancer Center and the University of British Columbia to measure patient-reported outcomes following breast cancer treatment, including breast-conserving therapy.">
	>

definition
	OBSERVATION[at0000] matches {    -- breast_q_bct_shittymetaha
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at9000] occurrences matches {0..1} matches {    -- With your breast area in mind, in the past week, how satisfied or dissatisfied have you been with:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2000] occurrences matches {0..1} matches {    -- How you look in the mirror clothed?
												value matches {
													1|[local::at2001],
													2|[local::at2002],
													3|[local::at2003],
													4|[local::at2004]
												}
											}
											ELEMENT[at2005] occurrences matches {0..1} matches {    -- How comfortable your bras fit?
												value matches {
													1|[local::at2006],
													2|[local::at2007],
													3|[local::at2008],
													4|[local::at2009]
												}
											}
											ELEMENT[at2010] occurrences matches {0..1} matches {    -- Being able to wear clothing that is more fitted?
												value matches {
													1|[local::at2011],
													2|[local::at2012],
													3|[local::at2013],
													4|[local::at2014]
												}
											}
											ELEMENT[at2015] occurrences matches {0..1} matches {    -- How you look in the mirror unclothed?
												value matches {
													1|[local::at2016],
													2|[local::at2017],
													3|[local::at2018],
													4|[local::at2019]
												}
											}
										}
									}
									CLUSTER[at9002] occurrences matches {0..1} matches {    -- The following questions are about your breasts and your breast cancer treatment (by treatment, we mean lumpectomy with or without radiation). If you have had a lumpectomy and radiation of both breasts, answer these questions thinking of the breast you are least satisfied with. With your breasts in mind, in the past week, how satisfied or dissatisfied have you been with:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2020] occurrences matches {0..1} matches {    -- How you look in the mirror clothed?
												value matches {
													1|[local::at2021],
													2|[local::at2022],
													3|[local::at2023],
													4|[local::at2024]
												}
											}
