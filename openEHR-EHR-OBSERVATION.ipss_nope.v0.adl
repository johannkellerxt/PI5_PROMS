		["fr"] = <
			items = <
				["at0000"] = <
					text = <"ipss_nope">
					description = <"L'International Prostate Symptom Score (IPSS) est un instrument d'évaluation standardisé utilisé pour mesurer la sévérité des symptômes des voies urinaires basses associés à l'hyperplasie bénigne de la prostate (HBP). Il comprend sept items symptomatiques et un item d'évaluation de la qualité de vie.">
				>
				["at2000"] = <
					text = <"Avec quelle fréquence avez-vous eu la sensation que votre vessie n'était pas complètement vidée après avoir uriné?">
					description = <"">
				>
				["at2001"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2002"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2003"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2004"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2005"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2006"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2007"] = <
					text = <"Avec quelle fréquence avez-vous du uriner à nouveau moins de deux heures après avoir fini d'uriner?">
					description = <"">
				>
				["at2008"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2009"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2010"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2011"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2012"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2013"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2014"] = <
					text = <"Avec quelle fréquence avez-vous eu une interruption du jet d'urine, c'est-à-dire démarrage du jet puis arret, puis redémarrage?">
					description = <"">
				>
				["at2015"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2016"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2017"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2018"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2019"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2020"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2021"] = <
					text = <"Avec quelle fréquence avez-vous eu des difficultés à retarder le moment d'uriner?">
					description = <"">
				>
				["at2022"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2023"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2024"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2025"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2026"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2027"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2028"] = <
					text = <"Avec quelle fréquence avez-vous eu une diminution de la force du jet d'urine?">
					description = <"">
				>
				["at2029"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2030"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2031"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2032"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2033"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2034"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2035"] = <
					text = <"Avec quelle fréquence avez-vous du forcer ou pousser pour commencer à uriner?">
					description = <"">
				>
				["at2036"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2037"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2038"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2039"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2040"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2041"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2042"] = <
					text = <"Combien de fois par nuit en moyenne, vous etes-vous levé pour uriner (entre le moment de votre coucher et celui de votre lever définitif du matin?)">
					description = <"">
				>
				["at2043"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2044"] = <
					text = <"1 fois">
					description = <"">
				>
				["at2045"] = <
					text = <"2 fois">
					description = <"">
				>
				["at2046"] = <
					text = <"3 fois">
					description = <"">
				>
				["at2047"] = <
					text = <"4 fois">
					description = <"">
				>
				["at2048"] = <
					text = <"5 fois">
					description = <"">
				>
				["at2049"] = <
					text = <"Comment vous sentiriez-vous si votre manière actuelle d'uriner ne devait plus changer à l'avenir?">
					description = <"">
				>
				["at2050"] = <
					text = <"très satisfait">
					description = <"">
				>
				["at2051"] = <
					text = <"satisfait">
					description = <"">
				>
				["at2052"] = <
					text = <"plutot satisfait">
					description = <"">
				>
				["at2053"] = <
					text = <"partagé (ni satisfait ni ennuyé)">
					description = <"">
				>
				["at2054"] = <
					text = <"plutot ennuyé">
					description = <"">
				>
				["at2055"] = <
					text = <"éprouvé">
					description = <"">
				>
				["at2056"] = <
					text = <"très éprouvé">
					description = <"">
				>
				["at2057"] = <
					text = <"IPSS SumScore">
					description = <"">
				>
				["at9000"] = <
					text = <"Toutes les données se réfèrent aux 4 dernières semaines.">
					description = <"Toutes les données se réfèrent aux 4 dernières semaines.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
			>
		>
