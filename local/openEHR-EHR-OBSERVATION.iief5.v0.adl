					description = <"">
				>
				["at0030"] = <
					text = <"Not difficult">
					description = <"">
				>
				["at0031"] = <
					text = <"When you attempted sexual intercourse, how often was it satisfactory for you?">
					description = <"">
				>
				["at0033"] = <
