		>
		["it"] = <
			items = <
				["at0000"] = <
					text = <"International Index of Erectile Function-5 (IIEF-5)">
					description = <"L'International Index of Erectile Function-5 (IIEF-5), noto anche come Sexual Health Inventory for Men (SHIM), è un questionario validato riferito dal paziente utilizzato per valutare la funzione erettile e per lo screening della disfunzione erettile.">
