description
	original_author = <
		["date"] = <"2026-05-08">
		["name"] = <"Johann Keller">
		["organisation"] = <"x-tention Informationstechnologie AG">
		["email"] = <"johann.keller@x-tention.ch">
	>
	lifecycle_state = <"unmanaged">
	other_contributors = <"Sol Fustinana, University Hospital Basel, Switzerland","Olha Nikolaieva, University Hospital Basel, Switzerland","Maren Diepenbruck, University Hospital Basel, Switzerland">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung der Antworten auf jedes der fünf Items des Fragebogens International Index of Erectile Function-5 (IIEF-5) sowie der berechneten Gesamtpunktzahl.">
			keywords = <"IIEF-5, SHIM, Internationaler Index der erektilen Funktion, Erektile Dysfunktion, Sexuelle Funktion, Patientenberichtetes Ergebnis, Urologie", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Zur Dokumentation der vom Patienten berichteten erektilen Funktion verwenden. Jedes der fünf Fragebogenitems wird gemäß dem IIEF-5-Bewertungssystem bewertet und ergibt eine Gesamtpunktzahl von 5 bis 25, wobei niedrigere Werte auf eine schwerere erektile Dysfunktion hinweisen. Der IIEF-5 ist ein Screening- und Bewertungsinstrument und stellt für sich allein keine Diagnose dar. Diese Darstellung ist unter der Creative Commons Attribution-ShareAlike 4.0 International License lizenziert.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the responses to each of the five items of the International Index of Erectile Function-5 (IIEF-5) questionnaire together with the calculated total score.">
			keywords = <"IIEF-5, SHIM, International Index of Erectile Function, Erectile dysfunction, Sexual function, Patient reported outcome, Urology", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Use to document patient-reported erectile function. Each of the five questionnaire items is scored according to the IIEF-5 scoring system, producing a total score ranging from 5 to 25, with lower scores indicating more severe erectile dysfunction. The IIEF-5 is a screening and assessment instrument and does not by itself establish a diagnosis. This representation is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License.">
		>
		["it"] = <
			language = <[ISO_639-1::it]>
			purpose = <"Registrare le risposte a ciascuno dei cinque item del questionario International Index of Erectile Function-5 (IIEF-5), insieme al punteggio totale calcolato.">
			keywords = <"IIEF-5, SHIM, Indice Internazionale della Funzione Erettile, Disfunzione erettile, Funzione sessuale, Esito riferito dal paziente, Urologia", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utilizzare per documentare la funzione erettile riferita dal paziente. Ciascuno dei cinque item del questionario è valutato secondo il sistema di punteggio dell'IIEF-5, producendo un punteggio totale compreso tra 5 e 25, in cui punteggi inferiori indicano una disfunzione erettile più grave. L'IIEF-5 è uno strumento di screening e valutazione e non consente, da solo, di stabilire una diagnosi. Questa rappresentazione è concessa con licenza Creative Commons Attribution-ShareAlike 4.0 International.">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Enregistrer les réponses à chacun des cinq items du questionnaire International Index of Erectile Function-5 (IIEF-5) ainsi que le score total calculé.">
			keywords = <"IIEF-5, SHIM, Indice international de la fonction érectile, Dysfonction érectile, Fonction sexuelle, Résultat rapporté par le patient, Urologie", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utiliser pour documenter la fonction érectile rapportée par le patient. Chacun des cinq items est coté selon le système de cotation IIEF-5, produisant un score total de 5 à 25, les scores les plus faibles indiquant une dysfonction érectile plus sévère. L'IIEF-5 est un instrument de dépistage et d'évaluation et ne permet pas, à lui seul, d'établir un diagnostic. Cette représentation est sous licence Creative Commons Attribution-ShareAlike 4.0 International.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Rosen RC, Cappelleri JC, Smith MD, Lipsky J, Peña BM. Development and evaluation of an abridged, 5-item version of the International Index of Erectile Function (IIEF-5) as a diagnostic tool for erectile dysfunction. International Journal of Impotence Research. 1999;11(6):319-326.">
		["current_contact"] = <"">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"0cf14d4b6a2f52ea39385af84c9b925d">
		["build_uid"] = <"9cc46d45-b954-4441-93a2-648b4df628b1">
		["ip_acknowledgements"] = <"The International Index of Erectile Function-5 (IIEF-5), also known as the Sexual Health Inventory for Men (SHIM), was developed by Raymond C. Rosen, Allen R. Cappelleri, Ronald C. Smith, James Lipsky, and Benjamin M. Peña.">
	>

definition
	OBSERVATION[at0000] matches {    -- International Index of Erectile Function-5 (IIEF-5)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at9000] occurrences matches {0..1} matches {    -- Over the past 6 months
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0004] occurrences matches {0..1} matches {    -- How do you rate your confidence that you could get and keep an erection?
												value matches {
													1|[local::at0005],
													2|[local::at0006],
													3|[local::at0007],
													4|[local::at0008],
													5|[local::at0009]
												}
											}
											ELEMENT[at0010] occurrences matches {0..1} matches {    -- When you had erections with sexual stimulation, how often were your erections hard enough for penetration?
												value matches {
													1|[local::at0012],
													2|[local::at0013],
													3|[local::at0014],
													4|[local::at0015],
													5|[local::at0016]
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {    -- During sexual intercourse, how often were you able to maintain your erection after you had penetrated (entered) your partner?
												value matches {
													1|[local::at0019],
													2|[local::at0020],
													3|[local::at0021],
													4|[local::at0022],
													5|[local::at0023]
												}
											}
											ELEMENT[at0024] occurrences matches {0..1} matches {    -- During sexual intercourse, how difficult was it to maintain your erection to completion of intercourse?
												value matches {
													1|[local::at0026],
													2|[local::at0027],
													3|[local::at0028],
													4|[local::at0029],
													5|[local::at0030]
												}
											}
											ELEMENT[at0031] occurrences matches {0..1} matches {    -- When you attempted sexual intercourse, how often was it satisfactory for you?
												value matches {
													1|[local::at0033],
													2|[local::at0034],
													3|[local::at0035],
													4|[local::at0036],
													5|[local::at0037]
												}
											}
										}
									}
									ELEMENT[at0038] occurrences matches {0..1} matches {    -- Total score
										value matches {
											DV_COUNT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["de"] = <
			items = <
				["at0000"] = <
					text = <"International Index of Erectile Function-5 (IIEF-5)">
					description = <"Der International Index of Erectile Function-5 (IIEF-5), auch Sexual Health Inventory for Men (SHIM) genannt, ist ein validierter patientenberichteter Fragebogen zur Beurteilung der erektilen Funktion und zum Screening auf erektile Dysfunktion.">
				>
				["at0004"] = <
					text = <"Wie hoch schätzen Sie Ihre Zuversichtlichkeit ein, bei sexueller Erregung eine Erektion zu bekommen und aufrecht erhalten zu können?">
					description = <"">
				>
				["at0005"] = <
					text = <"sehr niedrig">
					description = <"">
				>
				["at0006"] = <
					text = <"niedrig">
					description = <"">
				>
				["at0007"] = <
					text = <"moderat">
					description = <"">
				>
				["at0008"] = <
					text = <"hoch">
					description = <"">
				>
				["at0009"] = <
					text = <"sehr hoch">
					description = <"">
				>
				["at0010"] = <
					text = <"Wie häufig war Ihre Erektion nach sexueller Stimulation hart genug für eine Penetration?">
					description = <"">
				>
				["at0012"] = <
					text = <"fast nie/ nie">
					description = <"">
				>
				["at0013"] = <
					text = <"selten(seltener als in der Hälfte der Fälle)">
					description = <"">
				>
				["at0014"] = <
					text = <"manchmal(etwa in der Hälfte der Fälle)">
					description = <"">
				>
				["at0015"] = <
					text = <"meistens(häufiger als in der Hälfte der Fälle)">
					description = <"">
				>
				["at0016"] = <
					text = <"fast immer/ immer">
					description = <"">
				>
				["at0017"] = <
					text = <"Wie häufig konnten Sie Ihre Erektion beim Geschlechtsverkehr aufrecht erhalten, nachdem Sie in Ihre Partnerin eingedrungen waren?">
					description = <"">
				>
				["at0019"] = <
					text = <"fast nie/ nie">
					description = <"">
				>
				["at0020"] = <
					text = <"selten(seltener als in der Hälfte der Fälle)">
					description = <"">
				>
				["at0021"] = <
					text = <"manchmal(etwa in der Hälfte der Fälle)">
					description = <"">
				>
				["at0022"] = <
					text = <"meistens(häufiger als in der Hälfte der Fälle)">
					description = <"">
				>
				["at0023"] = <
					text = <"fast immer/ immer">
					description = <"">
				>
				["at0024"] = <
					text = <"Wie schwierig ist es für Sie, Ihre Erektion bis zum Ende des Geschlechtsverkehrs aufrecht zu erhalten?">
					description = <"">
				>
				["at0026"] = <
					text = <"extrem schwierig">
					description = <"">
				>
				["at0027"] = <
					text = <"sehr schwierig">
					description = <"">
				>
				["at0028"] = <
					text = <"schwierig">
					description = <"">
				>
				["at0029"] = <
					text = <"wenig schwierig">
					description = <"">
				>
				["at0030"] = <
					text = <"überhaupt nicht schwierig">
					description = <"">
				>
				["at0031"] = <
					text = <"Wie oft würden Sie den Geschlechtsverkehr mit Ihrer Partnerin als befriedigend einstufen?">
					description = <"">
				>
				["at0033"] = <
					text = <"fast nie/ nie">
					description = <"">
				>
				["at0034"] = <
					text = <"selten(seltener als in der Hälfte der Fälle)">
					description = <"">
				>
				["at0035"] = <
					text = <"manchmal(etwa in der Hälfte der Fälle)">
					description = <"">
				>
				["at0036"] = <
					text = <"meistens(häufiger als in der Hälfte der Fälle)">
					description = <"">
				>
				["at0037"] = <
					text = <"fast immer/ immer">
					description = <"">
				>
				["at0038"] = <
					text = <"Total score">
					description = <"">
				>
				["at9000"] = <
					text = <"Während der vergangenen 6 Monate:">
					description = <"Während der vergangenen 6 Monate:">
				>
				["at0001"] = <
