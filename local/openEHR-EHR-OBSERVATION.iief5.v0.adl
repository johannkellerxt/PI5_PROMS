		["en"] = <
			items = <
				["at0000"] = <
					text = <"International Index of Erectile Function-5 (IIEF-5)">
					description = <"The International Index of Erectile Function-5 (IIEF-5), also known as the Sexual Health Inventory for Men (SHIM), is a validated patient-reported outcome questionnaire used to assess erectile function and screen for erectile dysfunction.">
				>
				["at0004"] = <
					text = <"How do you rate your confidence that you could get and keep an erection?">
					description = <"">
				>
				["at0005"] = <
					text = <"Very low">
					description = <"">
				>
				["at0006"] = <
					text = <"Low">
					description = <"">
				>
				["at0007"] = <
					text = <"Moderate">
					description = <"">
				>
				["at0008"] = <
					text = <"High">
					description = <"">
				>
				["at0009"] = <
					text = <"Very High">
					description = <"">
				>
				["at0010"] = <
					text = <"When you had erections with sexual stimulation, how often were your erections hard enough for penetration?">
					description = <"">
				>
				["at0012"] = <
					text = <"Almost never/never">
					description = <"">
				>
				["at0013"] = <
					text = <"A few times (much less than half the time)">
					description = <"">
				>
				["at0014"] = <
					text = <"Sometimes (about half the time)">
					description = <"">
				>
				["at0015"] = <
					text = <"Most times (much more than half the time)">
					description = <"">
				>
				["at0016"] = <
					text = <"Almost always / always">
					description = <"">
				>
				["at0017"] = <
					text = <"During sexual intercourse, how often were you able to maintain your erection after you had penetrated (entered) your partner?">
					description = <"">
				>
				["at0019"] = <
					text = <"Almost never/never">
					description = <"">
				>
				["at0020"] = <
					text = <"A few times (much less than half the time)">
					description = <"">
				>
				["at0021"] = <
					text = <"Sometimes (about half the time)">
					description = <"">
				>
				["at0022"] = <
					text = <"Most times (much more than half the time)">
					description = <"">
				>
				["at0023"] = <
					text = <"Almost always / always">
					description = <"">
				>
				["at0024"] = <
					text = <"During sexual intercourse, how difficult was it to maintain your erection to completion of intercourse?">
					description = <"">
				>
				["at0026"] = <
					text = <"Extremely difficult">
					description = <"">
				>
				["at0027"] = <
