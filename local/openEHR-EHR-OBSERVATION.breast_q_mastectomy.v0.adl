													2|[local::at2028],
													3|[local::at2029],
													4|[local::at2030],
													5|[local::at2031]
												}
											}
											ELEMENT[at2032] occurrences matches {0..1} matches {    -- Emotionally able to do the things that you want to do?
												value matches {
													1|[local::at2033],
													2|[local::at2034],
													3|[local::at2035],
													4|[local::at2036],
													5|[local::at2037]
												}
											}
											ELEMENT[at2038] occurrences matches {0..1} matches {    -- Emotionally healthy?
												value matches {
													1|[local::at2039],
													2|[local::at2040],
													3|[local::at2041],
													4|[local::at2042],
													5|[local::at2043]
												}
											}
											ELEMENT[at2044] occurrences matches {0..1} matches {    -- Of equal worth to other women?
												value matches {
													1|[local::at2045],
													2|[local::at2046],
													3|[local::at2047],
													4|[local::at2048],
													5|[local::at2049]
