	lifecycle_state = <"unmanaged">
	other_contributors = <"Navin Ramachandran, UCLH, United Kingdom","Vebjørn Arntzen, Oslo University Hospital, Norway","Silje Ljosland Bakke, Helse Vest IKT AS, Norway","SB Bhattacharyya, Sudisa Consultancy Services, India">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung der Ergebnisse jedes Komponentenparameters sowie deren Gesamtsumme für den Internationalen Prostata-Symptom-Score (IPSS).">
			keywords = <"I-PSS, IPSS, Internationaler Prostata-Symptom-Score, Prostata, Benigne Prostatahyperplasie, BPH, Untere Harnwegssymptome", ...>
			copyright = <"© Clinical Models UK, openEHR Foundation">
			use = <"Zur Erfassung der Ergebnisse der einzelnen Komponentenparameter und der Gesamtsumme des IPSS verwenden. Die sieben Symptomitems werden zu einer Gesamtpunktzahl von 0 bis 35 addiert. Das Lebensqualitäts-Item wird separat erfasst und nicht in den Symptomscore einbezogen.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter and their total sum for the International Prostate Symptom Score (IPSS).">
			keywords = <"I-PSS, IPSS, International Prostate Symptom Score, Prostate, Benign prostatic hyperplasia, BPH, Lower urinary tract symptoms", ...>
			copyright = <"© Clinical Models UK, openEHR Foundation">
			use = <"Use to record the results for each component parameter and their total sum for the IPSS. The seven symptom items are summed to produce a total score from 0 to 35. The quality of life item is recorded separately and is not included in the symptom score.">
		>
		["it"] = <
			language = <[ISO_639-1::it]>
			purpose = <"*To record the results for each component parameter and their total sum for the International Prostate Symptom Score (IPSS). (en)">
			copyright = <"© Clinical Models UK, openEHR Foundation">
			use = <"*Use to record the results for each component parameter and their total sum for the IPSS. The seven symptom items are summed to produce a total score from 0 to 35. The quality of life item is recorded separately and is not included in the symptom score. (en)">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Enregistrer les résultats de chaque paramètre composant ainsi que leur somme totale pour l'International Prostate Symptom Score (IPSS).">
			keywords = <"I-PSS, IPSS, Score international des symptômes prostatiques, Prostate, Hyperplasie bénigne de la prostate, HBP, Symptômes des voies urinaires basses", ...>
			copyright = <"© Clinical Models UK, openEHR Foundation">
			use = <"Utiliser pour enregistrer les résultats de chaque paramètre composant et leur somme totale pour l'IPSS. Les sept items de symptômes sont additionnés pour obtenir un score total de 0 à 35. L'item de qualité de vie est enregistré séparément et n'est pas inclus dans le score des symptômes.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"[{'citation': 'Derived from: I-PSS Prostate Score, Draft archetype [Internet]. Apperta UK, Apperta UK Clinical Knowledge Manager [cited: 2020-11-11].'}, {'citation': 'Badía X, García-Losa M, Dal-Ré R. Ten-language translation and harmonization of the International Prostate Symptom Score: developing a methodology for multinational clinical trials. European Urology. 1997;31(2):129-140. doi:10.1159/000474438.'}, {'citation': 'International Prostate Symptom Score (IPSS) openEHR archetype. openEHR Clinical Knowledge Manager. Archetype ID: openEHR-EHR-OBSERVATION.ipss.v1.'}]">
		["current_contact"] = <"Navin Ramachandran, UCLH, navinramachandran@nhs.net">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
