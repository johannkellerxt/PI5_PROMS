		["fr"] = <
			items = <
				["at0000"] = <
					text = <"International prostate symptom score (IPSS)">
					description = <"L'International Prostate Symptom Score (IPSS) est un score d'évaluation utilisé pour le dépistage, le diagnostic et le suivi des symptômes associés à l'hyperplasie bénigne de la prostate (HBP). Il comprend sept questions sur les symptômes et une question sur la qualité de vie.">
				>
				["at2000"] = <
					text = <"Avec quelle fréquence avez-vous eu la sensation que votre vessie n'était pas complètement vidée après avoir uriné?">
					description = <"">
				>
				["at2001"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2002"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2003"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2004"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2005"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2006"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2007"] = <
					text = <"Avec quelle fréquence avez-vous du uriner à nouveau moins de deux heures après avoir fini d'uriner?">
					description = <"">
				>
				["at2008"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2009"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2010"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2011"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2012"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2013"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2014"] = <
					text = <"Avec quelle fréquence avez-vous eu une interruption du jet d'urine, c'est-à-dire démarrage du jet puis arret, puis redémarrage?">
					description = <"">
				>
				["at2015"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2016"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
					description = <"">
				>
				["at2017"] = <
					text = <"Environ 1 fois sur 3">
					description = <"">
				>
				["at2018"] = <
					text = <"Environ 1 fois sur 2 (env. 50%)">
					description = <"">
				>
				["at2019"] = <
					text = <"Environ 2 fois sur 3">
					description = <"">
				>
				["at2020"] = <
					text = <"Presque toujours">
					description = <"">
				>
				["at2021"] = <
					text = <"Avec quelle fréquence avez-vous eu des difficultés à retarder le moment d'uriner?">
					description = <"">
				>
				["at2022"] = <
					text = <"Jamais">
					description = <"">
				>
				["at2023"] = <
					text = <"Environ 1 fois sur 5 (<20%)">
