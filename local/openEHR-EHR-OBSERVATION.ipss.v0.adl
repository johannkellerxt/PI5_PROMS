description
	original_author = <
		["date"] = <"2026-05-08">
		["name"] = <"Johann Keller">
		["organisation"] = <"x-tention Informationstechnologie AG">
		["email"] = <"johann.keller@x-tention.ch">
	>
	lifecycle_state = <"unmanaged">
	other_contributors = <"Sol Fustinana, University Hospital Basel, Switzerland","Olha Nikolaieva, University Hospital Basel, Switzerland","Maren Diepenbruck, University Hospital Basel, Switzerland">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung der Bewertung und Punktzahl jedes der 13 Items der Delirium Observation Screening Scale (DOS) sowie der berechneten Gesamtpunktzahl.">
			keywords = <"DOS, Delirium Observation Screening Scale, Delir, Delir-Screening, Pflegebeobachtung, Veränderter mentaler Status, Kognitive Beeinträchtigung", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Zur schichtbezogenen pflegerischen Beobachtung und zum Delir-Screening während der Routineversorgung. Jedes Item wird anhand des beobachteten Verhaltens bewertet; die Items 3, 8 und 9 werden umgekehrt gewertet. Die Summe der Itemwerte ergibt eine Gesamtpunktzahl von 0 bis 13. Ein Ergebnis von mindestens 3 Punkten gilt als positiver Screen und soll eine weiterführende Beurteilung, beispielsweise mit der Confusion Assessment Method (CAM), auslösen. Die DOS ist ein Screeninginstrument und stellt für sich allein keine Delirdiagnose.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the rating and score for each of the 13 items of the Delirium Observation Screening Scale (DOS), together with the calculated total score.">
			keywords = <"DOS, Delirium Observation Screening Scale, Delirium, Delirium screening, Nursing observation, Altered mental status, Cognitive impairment", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Use for shift-based nursing observation and delirium screening during routine care. Rate each item from observed behaviour; items 3, 8, and 9 are reverse scored. Sum the item scores to obtain a total from 0 to 13. A score of 3 or more is a positive screen and should prompt further assessment, such as the Confusion Assessment Method (CAM). The DOS is a screening instrument and does not by itself establish a diagnosis of delirium.">
		>
		["it"] = <
			language = <[ISO_639-1::it]>
			purpose = <"*To record the rating and score for each of the 13 items of the Delirium Observation Screening Scale (DOS), together with the calculated total score. (en)">
			copyright = <"© openEHR Foundation test">
			use = <"*Use for shift-based nursing observation and delirium screening during routine care. Rate each item from observed behaviour; items 3, 8, and 9 are reverse scored. Sum the item scores to obtain a total from 0 to 13. A score of 3 or more is a positive screen and should prompt further assessment, such as the Confusion Assessment Method (CAM). The DOS is a screening instrument and does not by itself establish a diagnosis of delirium. (en)">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Enregistrer l'évaluation et le score de chacun des 13 items de la Delirium Observation Screening Scale (DOS), ainsi que le score total calculé.">
			keywords = <"DOS, Delirium Observation Screening Scale, Délirium, Dépistage du délirium, Observation infirmière, Altération de l'état mental, Troubles cognitifs", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utiliser pour l'observation infirmière par période de travail et le dépistage du délirium pendant les soins habituels. Coter chaque item à partir du comportement observé; les items 3, 8 et 9 sont cotés en sens inverse. La somme des items donne un score total de 0 à 13. Un score d'au moins 3 constitue un dépistage positif et doit conduire à une évaluation complémentaire, par exemple avec la Confusion Assessment Method (CAM). La DOS est un instrument de dépistage et ne permet pas, à elle seule, de poser un diagnostic de délirium.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"[{'citation': 'Schuurmans MJ, Shortridge-Baggett LM, Duursma SA. The Delirium Observation Screening Scale: a screening instrument for delirium. Research and Theory for Nursing Practice. 2003;17(1):31-50. doi:10.1891/RTNP.17.1.31.53169.'}, {'citation': 'Gavinski K, Carnahan R, Weckmann M. Validation of the Delirium Observation Screening Scale in a hospitalized older population. Journal of Hospital Medicine. 2016;11(7):494-497. doi:10.1002/jhm.2580.'}, {'citation': 'Universitätsspital Basel, Klinische Pflegewissenschaft. Delirium Screening durch Beobachtung / Delirium Observation Screening Scale (DOS). Adaptiert von Schuurmans (2001), Variante 2.2. 2007.'}]">
		["current_contact"] = <"">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["build_uid"] = <"3f0e5c8d-88eb-4b06-9775-5cb84e57cd42">
		["ip_acknowledgements"] = <"The Delirium Observation Screening Scale (DOS) was developed by M. J. Schuurmans, L. M. Shortridge-Baggett, and S. A. Duursma.">
		["MD5-CAM-1.0.1"] = <"9781ee02821e44662cd2797e452eae66">
	>

definition
	OBSERVATION[at0000] matches {    -- International prostate symptom score (IPSS)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at9000] occurrences matches {0..1} matches {    -- *All information refers to the last 4 weeks. (de)
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2000] occurrences matches {0..1} matches {    -- Over the past month, how often have you had a sensation of not emptying your bladder completely ater you fnisih urinating?
												value matches {
													0|[local::at2001],
													1|[local::at2002],
													2|[local::at2003],
													3|[local::at2004],
													4|[local::at2005],
													5|[local::at2006]
												}
											}
											ELEMENT[at2007] occurrences matches {0..1} matches {    -- Over the past month, how often have you had to urinate again less than two hours after you finished urinating?
												value matches {
													0|[local::at2008],
													1|[local::at2009],
													2|[local::at2010],
													3|[local::at2011],
													4|[local::at2012],
													5|[local::at2013]
												}
											}
											ELEMENT[at2014] occurrences matches {0..1} matches {    -- Over the past month, how often have you found you stopped and started again several times when you urinated?
												value matches {
													0|[local::at2015],
													1|[local::at2016],
													2|[local::at2017],
													3|[local::at2018],
													4|[local::at2019],
													5|[local::at2020]
												}
											}
											ELEMENT[at2021] occurrences matches {0..1} matches {    -- Over the past month, how difficult have you found it to postpone urination?
												value matches {
													0|[local::at2022],
													1|[local::at2023],
													2|[local::at2024],
													3|[local::at2025],
													4|[local::at2026],
													5|[local::at2027]
												}
											}
											ELEMENT[at2028] occurrences matches {0..1} matches {    -- Over the past month, how often have you had a weak urinary stream?
												value matches {
													0|[local::at2029],
													1|[local::at2030],
													2|[local::at2031],
													3|[local::at2032],
													4|[local::at2033],
													5|[local::at2034]
												}
											}
											ELEMENT[at2035] occurrences matches {0..1} matches {    -- Over the past month, how often have you had to push or strain to begin urination?
												value matches {
													0|[local::at2036],
													1|[local::at2037],
													2|[local::at2038],
													3|[local::at2039],
													4|[local::at2040],
													5|[local::at2041]
												}
											}
											ELEMENT[at2042] occurrences matches {0..1} matches {    -- Over the past month, how many times did you most typically get up to urinate from the time you went to bed until the time you got up in the morning?
												value matches {
													0|[local::at2043],
													1|[local::at2044],
													2|[local::at2045],
													3|[local::at2046],
													4|[local::at2047],
													5|[local::at2048]
												}
											}
											ELEMENT[at2049] occurrences matches {0..1} matches {    -- If you were to spend the rest of your life with your urinary condition the way it is now, how would you feel about that?
												value matches {
													0|[local::at2050],
													1|[local::at2051],
													2|[local::at2052],
													3|[local::at2053],
													4|[local::at2054],
													5|[local::at2055],
													6|[local::at2056]
												}
											}
										}
									}
									ELEMENT[at2057] occurrences matches {0..1} matches {    -- IPSS SumScore
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::339]>
												list = <
													["1"] = <
														units = <"[g]">
														magnitude = <|0.0..35.0|>
													>
												>
											>
											DV_COUNT matches {
												magnitude matches {|0..35|}
											}
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["de"] = <
			items = <
				["at0000"] = <
					text = <"International prostate symptom score (IPSS)">
					description = <"Die Delirium Observation Screening Scale (DOS) ist ein aus 13 Items bestehendes, beobachtungsbasiertes Screeninginstrument zur Erkennung von Anzeichen eines Delirs während der routinemässigen Pflege. Jedes Item wird mit 0 oder 1 Punkt bewertet; ein Gesamtergebnis von mindestens 3 Punkten gilt als positiver Delir-Screen und erfordert eine weiterführende Beurteilung.">
				>
				["at2000"] = <
					text = <"Wie oft hatten Sie das Gefühl, dass Ihre Blase nach dem Wasserlassen nicht ganz entleert war?">
					description = <"">
				>
				["at2001"] = <
					text = <"Nie">
					description = <"">
				>
				["at2002"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2003"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2004"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2005"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2006"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2007"] = <
					text = <"Wie oft mussten Sie innerhalb von 2 Stunden erneut Wasser lassen?">
					description = <"">
				>
				["at2008"] = <
					text = <"Nie">
					description = <"">
				>
				["at2009"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2010"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2011"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2012"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2013"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2014"] = <
					text = <"Wie oft mussten Sie beim Wasserlassen mehrmals aufhören und wieder neu beginnen (Harnstottern)?">
					description = <"">
				>
				["at2015"] = <
					text = <"Nie">
					description = <"">
				>
				["at2016"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2017"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2018"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2019"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2020"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2021"] = <
					text = <"Wie oft hatten Sie Schwierigkeiten, das Wasserlassen hinauszuzögern?">
					description = <"">
				>
				["at2022"] = <
					text = <"Nie">
					description = <"">
				>
				["at2023"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2024"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2025"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2026"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2027"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2028"] = <
					text = <"Wie oft hatten Sie einen schwachen Strahl beim Wasserlassen?">
					description = <"">
				>
				["at2029"] = <
					text = <"Nie">
					description = <"">
				>
				["at2030"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2031"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2032"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2033"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2034"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2035"] = <
					text = <"Wie oft mussten Sie pressen oder sich anstrengen, um mit dem Wasserlassen zu beginnen?">
					description = <"">
				>
				["at2036"] = <
					text = <"Nie">
					description = <"">
				>
				["at2037"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2038"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2039"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2040"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2041"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2042"] = <
					text = <"Wie oft sind Sie iim Durchschnitt nachts aufgestanden, um Wasser zu lassen. Massgebend ist der Zeitraum vom Zubettgehen bis zum Aufstehen am Morgen.">
					description = <"">
				>
				["at2043"] = <
					text = <"Nie">
					description = <"">
				>
				["at2044"] = <
					text = <"Einmal">
					description = <"">
				>
				["at2045"] = <
					text = <"Zweimal">
					description = <"">
				>
				["at2046"] = <
					text = <"Dreimal">
					description = <"">
				>
				["at2047"] = <
					text = <"Viermal">
					description = <"">
				>
				["at2048"] = <
					text = <"Fünfmal oder mehr">
					description = <"">
				>
				["at2049"] = <
					text = <"Wie würden Sie sich fühlen, wenn sich Ihre jetzigen Symptome beim Wasserlassen in Ihrem weiteren Leben nicht mehr ändern würden?">
					description = <"">
				>
				["at2050"] = <
					text = <"ausgezeichnet">
					description = <"">
				>
				["at2051"] = <
					text = <"zufrieden">
					description = <"">
				>
				["at2052"] = <
					text = <"überwiegend zufrieden">
					description = <"">
				>
				["at2053"] = <
					text = <"gemischt, teils zufrieden, teils unzufrieden">
					description = <"">
				>
				["at2054"] = <
					text = <"überwiegend unzufrieden">
					description = <"">
				>
				["at2055"] = <
					text = <"unglücklich">
					description = <"">
				>
				["at2056"] = <
					text = <"sehr schlecht">
					description = <"">
				>
				["at2057"] = <
					text = <"IPSS SumScore">
					description = <"">
				>
				["at9000"] = <
					text = <"All information refers to the last 4 weeks.">
					description = <"All information refers to the last 4 weeks.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"International prostate symptom score (IPSS)">
					description = <"The Delirium Observation Screening Scale (DOS) is a 13-item, observation-based screening instrument designed to identify signs of delirium during routine nursing care. Each item is scored 0 or 1; a total score of 3 or more indicates a positive delirium screen and requires further assessment.">
				>
				["at2000"] = <
					text = <"Over the past month, how often have you had a sensation of not emptying your bladder completely ater you fnisih urinating?">
					description = <"">
				>
