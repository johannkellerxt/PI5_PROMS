		["en"] = <
			items = <
				["at0000"] = <
					text = <"International prostate symptom score (IPSS)">
					description = <"The International Prostate Symptom Score (IPSS) is an assessment score used to screen for, diagnose, and track symptoms associated with benign prostatic hyperplasia (BPH). It consists of seven symptom questions and one quality of life question.">
				>
				["at2000"] = <
					text = <"How often have you had a sensation of not emptying your bladder completely ater you fnisih urinating?">
					description = <"">
				>
