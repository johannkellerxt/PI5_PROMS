		["it"] = <
			items = <
				["at0000"] = <
					text = <"ipss_shittymeta">
					description = <"L'International Prostate Symptom Score (IPSS) è uno strumento di valutazione utilizzato per determinare la gravità dei sintomi delle basse vie urinarie associati all'iperplasia prostatica benigna (IPB). Comprende sette domande sui sintomi e una domanda sulla qualità di vita.">
				>
