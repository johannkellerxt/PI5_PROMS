				["at2033"] = <
					text = <"More than half the time">
					description = <"">
				>
				["at2034"] = <
					text = <"Almost always">
					description = <"">
				>
				["at2035"] = <
					text = <"Over the past month, how often have you had to push or strain to begin urination?">
					description = <"">
				>
				["at2036"] = <
					text = <"Not at all">
					description = <"">
				>
				["at2037"] = <
					text = <"Less than 1 time in 5">
					description = <"">
				>
				["at2038"] = <
					text = <"Less than half the time">
					description = <"">
				>
				["at2039"] = <
					text = <"Abou half the time">
					description = <"">
				>
				["at2040"] = <
					text = <"More than half the time">
					description = <"">
				>
				["at2041"] = <
					text = <"Almost always">
					description = <"">
				>
				["at2042"] = <
					text = <"Over the past month, how many times did you most typically get up to urinate from the time you went to bed until the time you got up in the morning?">
					description = <"">
				>
				["at2043"] = <
					text = <"None">
					description = <"">
				>
				["at2044"] = <
					text = <"1 time">
					description = <"">
				>
				["at2045"] = <
					text = <"2 times">
					description = <"">
				>
				["at2046"] = <
					text = <"3 times">
					description = <"">
				>
				["at2047"] = <
					text = <"4 times">
					description = <"">
				>
				["at2048"] = <
					text = <"5 times or more">
					description = <"">
				>
				["at2049"] = <
					text = <"If you were to spend the rest of your life with your urinary condition the way it is now, how would you feel about that?">
					description = <"">
				>
				["at2050"] = <
					text = <"delighted">
					description = <"">
				>
				["at2051"] = <
					text = <"pleased">
					description = <"">
				>
				["at2052"] = <
					text = <"mostly satisfied">
					description = <"">
				>
				["at2053"] = <
					text = <"mixed, about equally satisfied and dissatisfied">
					description = <"">
				>
				["at2054"] = <
					text = <"mostly dissatisfied">
					description = <"">
				>
				["at2055"] = <
					text = <"unhappty">
					description = <"">
				>
				["at2056"] = <
					text = <"terrible">
					description = <"">
				>
				["at2057"] = <
					text = <"IPSS SumScore">
					description = <"">
				>
				["at9000"] = <
					text = <"*All information refers to the last 4 weeks. (de)">
					description = <"*All information refers to the last 4 weeks. (de)">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
