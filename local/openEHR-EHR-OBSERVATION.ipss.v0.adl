		["build_uid"] = <"3626acfe-f829-4e52-9b97-4f0bb6cf4c59">
		["ip_acknowledgements"] = <"Public domain">
	>

definition
	OBSERVATION[at0000] matches {    -- International prostate symptom score (IPSS)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at9000] occurrences matches {0..1} matches {    -- Over the past month.
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2000] occurrences matches {0..1} matches {    -- How often have you had a sensation of not emptying your bladder completely ater you fnisih urinating?
												value matches {
													0|[local::at2001],
													1|[local::at2002],
													2|[local::at2003],
													3|[local::at2004],
													4|[local::at2005],
													5|[local::at2006]
												}
											}
											ELEMENT[at2007] occurrences matches {0..1} matches {    -- How often have you had to urinate again less than two hours after you finished urinating?
												value matches {
													0|[local::at2008],
													1|[local::at2009],
													2|[local::at2010],
													3|[local::at2011],
													4|[local::at2012],
													5|[local::at2013]
												}
											}
											ELEMENT[at2014] occurrences matches {0..1} matches {    -- How often have you found you stopped and started again several times when you urinated?
												value matches {
													0|[local::at2015],
													1|[local::at2016],
													2|[local::at2017],
													3|[local::at2018],
													4|[local::at2019],
													5|[local::at2020]
												}
											}
											ELEMENT[at2021] occurrences matches {0..1} matches {    -- How difficult have you found it to postpone urination?
												value matches {
													0|[local::at2022],
													1|[local::at2023],
													2|[local::at2024],
													3|[local::at2025],
													4|[local::at2026],
													5|[local::at2027]
												}
											}
											ELEMENT[at2028] occurrences matches {0..1} matches {    -- How often have you had a weak urinary stream?
												value matches {
													0|[local::at2029],
													1|[local::at2030],
													2|[local::at2031],
													3|[local::at2032],
													4|[local::at2033],
													5|[local::at2034]
												}
											}
											ELEMENT[at2035] occurrences matches {0..1} matches {    -- How often have you had to push or strain to begin urination?
												value matches {
													0|[local::at2036],
													1|[local::at2037],
													2|[local::at2038],
													3|[local::at2039],
													4|[local::at2040],
													5|[local::at2041]
												}
											}
											ELEMENT[at2042] occurrences matches {0..1} matches {    -- How many times did you most typically get up to urinate from the time you went to bed until the time you got up in the morning?
												value matches {
													0|[local::at2043],
													1|[local::at2044],
													2|[local::at2045],
													3|[local::at2046],
													4|[local::at2047],
													5|[local::at2048]
												}
											}
											ELEMENT[at2049] occurrences matches {0..1} matches {    -- If you were to spend the rest of your life with your urinary condition the way it is now, how would you feel about that?
												value matches {
													0|[local::at2050],
													1|[local::at2051],
													2|[local::at2052],
													3|[local::at2053],
													4|[local::at2054],
													5|[local::at2055],
													6|[local::at2056]
												}
											}
										}
									}
									ELEMENT[at2057] occurrences matches {0..1} matches {    -- IPSS SumScore
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..35|}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["de"] = <
			items = <
				["at0000"] = <
					text = <"International prostate symptom score (IPSS)">
					description = <"Der Internationale Prostata-Symptom-Score (IPSS) ist ein Bewertungsinstrument zur Erkennung, Beurteilung und Verlaufskontrolle von Symptomen einer benignen Prostatahyperplasie (BPH). Er umfasst sieben Symptomfragen und eine Frage zur Lebensqualität.">
				>
				["at2000"] = <
					text = <"Wie oft hatten Sie das Gefühl, dass Ihre Blase nach dem Wasserlassen nicht ganz entleert war?">
					description = <"">
				>
				["at2001"] = <
					text = <"Nie">
					description = <"">
				>
				["at2002"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2003"] = <
					text = <"Seltener als in der Hälfte aller Fälle">
					description = <"">
				>
				["at2004"] = <
					text = <"Ungefähr in der Hälfte aller Fälle (ca. 50%)">
					description = <"">
				>
				["at2005"] = <
					text = <"In mehr als der Hälfte aller Fälle">
					description = <"">
				>
				["at2006"] = <
					text = <"fast immer">
					description = <"">
				>
				["at2007"] = <
					text = <"Wie oft mussten Sie innerhalb von 2 Stunden erneut Wasser lassen?">
					description = <"">
				>
				["at2008"] = <
					text = <"Nie">
					description = <"">
				>
				["at2009"] = <
					text = <"Seltener als in 1 von 5 Fällen (<20%)">
					description = <"">
				>
				["at2010"] = <
