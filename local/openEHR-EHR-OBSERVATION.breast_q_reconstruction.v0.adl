description
	original_author = <
		["date"] = <"2026-05-08">
		["name"] = <"Johann Keller">
		["organisation"] = <"x-tention Informationstechnologie AG">
		["email"] = <"johann.keller@x-tention.ch">
	>
	lifecycle_state = <"unmanaged">
	other_contributors = <"Sol Fustinana, University Hospital Basel, Switzerland","Olha Nikolaieva, University Hospital Basel, Switzerland","Maren Diepenbruck, University Hospital Basel, Switzerland">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung der Antworten auf die Items des BREAST-Q Rekonstruktionsfragebogens und zur Berechnung der entsprechenden patientenberichteten Ergebnisscores.">
			keywords = <"BREAST-Q, BREAST-Q Rekonstruktion, Brustrekonstruktion, Brustkrebs, Patientenberichtetes Ergebnis, Lebensqualität, Brustchirurgie", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Zur Dokumentation patientenberichteter Ergebnisse nach einer Brustrekonstruktion verwenden. Das BREAST-Q Rekonstruktionsmodul bewertet Bereiche wie Zufriedenheit mit der Brust, psychosoziales Wohlbefinden, sexuelles Wohlbefinden, körperliches Wohlbefinden, Zufriedenheit mit dem Behandlungsergebnis und Zufriedenheit mit der Versorgung. Die Scores werden gemäß dem BREAST-Q Bewertungssystem berechnet. Dieses Instrument dient der Lebensqualitätsbewertung und stellt keine klinische Diagnose dar. Diese Darstellung ist unter der Creative Commons Attribution-ShareAlike 4.0 International License lizenziert.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record responses to the BREAST-Q Reconstruction questionnaire items and calculate the corresponding patient-reported outcome scores.">
			keywords = <"BREAST-Q, BREAST-Q Reconstruction, Breast reconstruction, Breast cancer, Patient reported outcome, Quality of life, Breast surgery", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Use to document patient-reported outcomes following breast reconstruction. The BREAST-Q Reconstruction module evaluates domains including satisfaction with breasts, psychosocial well-being, sexual well-being, physical well-being, satisfaction with the outcome, and satisfaction with care. Scores are calculated according to the BREAST-Q scoring system. This instrument is a quality-of-life assessment tool and does not establish a clinical diagnosis. This representation is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License.">
		>
		["it"] = <
			language = <[ISO_639-1::it]>
			purpose = <"Registrare le risposte agli item del questionario BREAST-Q Ricostruzione e calcolare i relativi punteggi degli esiti riferiti dalla paziente.">
			keywords = <"BREAST-Q, BREAST-Q Ricostruzione, Ricostruzione mammaria, Cancro della mammella, Esito riferito dalla paziente, Qualità di vita, Chirurgia mammaria", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utilizzare per documentare gli esiti riferiti dalle pazienti dopo una ricostruzione mammaria. Il modulo BREAST-Q Ricostruzione valuta domini quali la soddisfazione per la mammella, il benessere psicosociale, il benessere sessuale, il benessere fisico, la soddisfazione per il risultato e la soddisfazione per le cure ricevute. I punteggi sono calcolati secondo il sistema di scoring BREAST-Q. Questo strumento è una misura della qualità di vita e non consente di stabilire una diagnosi clinica. Questa rappresentazione è concessa con licenza Creative Commons Attribution-ShareAlike 4.0 International.">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Enregistrer les réponses aux items du questionnaire BREAST-Q Reconstruction et calculer les scores correspondants des résultats rapportés par les patientes.">
			keywords = <"BREAST-Q, BREAST-Q Reconstruction, Reconstruction mammaire, Cancer du sein, Résultat rapporté par la patiente, Qualité de vie, Chirurgie mammaire", ...>
			copyright = <"© openEHR Foundation test">
			use = <"Utiliser pour documenter les résultats rapportés par les patientes après une reconstruction mammaire. Le module BREAST-Q Reconstruction évalue notamment la satisfaction vis-à-vis des seins, le bien-être psychosocial, le bien-être sexuel, le bien-être physique, la satisfaction à l'égard du résultat et la satisfaction à l'égard des soins. Les scores sont calculés selon le système de cotation BREAST-Q. Cet instrument est un outil d'évaluation de la qualité de vie et ne permet pas d'établir un diagnostic clinique. Cette représentation est sous licence Creative Commons Attribution-ShareAlike 4.0 International.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Pusic AL, Klassen AF, Scott AM, Klok JA, Cordeiro PG, Cano SJ. Development of a new patient-reported outcome measure for breast surgery: the BREAST-Q. Plastic and Reconstructive Surgery. 2009;124(2):345-353. doi:10.1097/PRS.0b013e3181aee807.

Memorial Sloan Kettering Cancer Center and University of British Columbia. BREAST-Q Patient Reported Outcome Measure. Reconstruction Module.">
		["current_contact"] = <"">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"35b99537c536714ab5229157f9825363">
		["build_uid"] = <"95a8073f-92df-47e1-96c4-e4f7bc808827">
		["ip_acknowledgements"] = <"The BREAST-Q Reconstruction module was developed by the Memorial Sloan Kettering Cancer Center and the University of British Columbia to measure patient-reported outcomes following breast reconstruction surgery.">
	>

definition
	OBSERVATION[at0000] matches {    -- BREAST-Q Reconstruction
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at9000] occurrences matches {0..1} matches {    -- In the past week, with your abdomen (tummy area) in mind, how often have you experienced:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2000] occurrences matches {0..1} matches {    -- Difficulty sitting up because of abdominal muscle weakness (e.g., getting out of bed)?
												value matches {
													1|[local::at2001],
													2|[local::at2002],
													3|[local::at2003],
													4|[local::at2004],
													5|[local::at2005]
												}
											}
											ELEMENT[at2006] occurrences matches {0..1} matches {    -- Difficulty doing everyday activities because of abdominal muscle weakness (e.g., making your bed)?
												value matches {
													1|[local::at2007],
													2|[local::at2008],
													3|[local::at2009],
													4|[local::at2010],
													5|[local::at2011]
												}
											}
											ELEMENT[at2012] occurrences matches {0..1} matches {    -- Abdominal discomfort?
												value matches {
													1|[local::at2013],
													2|[local::at2014],
													3|[local::at2015],
													4|[local::at2016],
													5|[local::at2017]
												}
											}
											ELEMENT[at2018] occurrences matches {0..1} matches {    -- Abdominal bloating?
												value matches {
													1|[local::at2019],
													2|[local::at2020],
													3|[local::at2021],
													4|[local::at2022],
													5|[local::at2023]
												}
											}
											ELEMENT[at2024] occurrences matches {0..1} matches {    -- Abdominal bulging?
												value matches {
													1|[local::at2025],
													2|[local::at2026],
													3|[local::at2027],
													4|[local::at2028],
													5|[local::at2029]
												}
											}
											ELEMENT[at2030] occurrences matches {0..1} matches {    -- Tightness in your abdomen?
												value matches {
													1|[local::at2031],
													2|[local::at2032],
													3|[local::at2033],
													4|[local::at2034],
													5|[local::at2035]
												}
											}
											ELEMENT[at2036] occurrences matches {0..1} matches {    -- Pulling in your abdomen?
												value matches {
													1|[local::at2037],
													2|[local::at2038],
													3|[local::at2039],
													4|[local::at2040],
													5|[local::at2041]
												}
											}
											ELEMENT[at2042] occurrences matches {0..1} matches {    -- Difficulty sitting up because of abdominal muscle weakness (e.g., getting out of bed)?
												value matches {
													1|[local::at2043],
													2|[local::at2044],
													3|[local::at2045],
													4|[local::at2046],
													5|[local::at2047]
												}
											}
											ELEMENT[at2048] occurrences matches {0..1} matches {    -- Difficulty doing everyday activities because of abdominal muscle weakness (e.g., making your bed)?
												value matches {
													1|[local::at2049],
													2|[local::at2050],
													3|[local::at2051],
													4|[local::at2052],
													5|[local::at2053]
												}
											}
											ELEMENT[at2054] occurrences matches {0..1} matches {    -- Abdominal discomfort?
												value matches {
													1|[local::at2055],
													2|[local::at2056],
													3|[local::at2057],
													4|[local::at2058],
													5|[local::at2059]
												}
											}
											ELEMENT[at2060] occurrences matches {0..1} matches {    -- Abdominal bloating?
												value matches {
													1|[local::at2061],
													2|[local::at2062],
													3|[local::at2063],
													4|[local::at2064],
													5|[local::at2065]
												}
											}
										}
									}
									CLUSTER[at9001] occurrences matches {0..1} matches {    -- In the past week, how often have you experienced:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2066] occurrences matches {0..1} matches {    -- Pain in the muscles of your chest?
												value matches {
													1|[local::at2067],
													2|[local::at2068],
													3|[local::at2069]
												}
											}
											ELEMENT[at2070] occurrences matches {0..1} matches {    -- Throbbing feeling in your breast area?
