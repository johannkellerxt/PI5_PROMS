				["at9002"] = <
					text = <"Wenn Sie an ihre Brust denken, wie oft fühlten Sie sich in der letzten Woche:">
					description = <"Wenn Sie an ihre Brust denken, wie oft fühlten Sie sich in der letzten Woche:">
				>
				["at9003"] = <
					text = <"Wenn bei Ihnen beide Brüste bestrahlt wurden, denken Sie bei der Beantwortung dieser Fragen an die Brust, mit der Sie weniger zufrieden sind. Wenn Sie an Ihre bestrahlte/n Brust/Brüste denken, wie sehr hat Sie in der letzten Woche Folgendes gestört:">
					description = <"Wenn bei Ihnen beide Brüste bestrahlt wurden, denken Sie bei der Beantwortung dieser Fragen an die Brust, mit der Sie weniger zufrieden sind. Wenn Sie an Ihre bestrahlte/n Brust/Brüste denken, wie sehr hat Sie in der letzten Woche Folgendes gestört:">
				>
				["at9004"] = <
					text = <"Wie zufrieden waren Sie in der letzten Woche mit:">
					description = <"Wie zufrieden waren Sie in der letzten Woche mit:">
				>
				["at9005"] = <
					text = <"Wenn Sie eine Mastektomie und Rekonstruktion beider Brüste hatten, denken Sie bei der Beantwortung dieser Fragen an die Brust, mit der Sie weniger zufrieden sind. Wenn Sie an Ihre Brust denken, wie zufrieden waren Sie in der letzten Woche mit dem Folgenden:">
					description = <"Wenn Sie eine Mastektomie und Rekonstruktion beider Brüste hatten, denken Sie bei der Beantwortung dieser Fragen an die Brust, mit der Sie weniger zufrieden sind. Wenn Sie an Ihre Brust denken, wie zufrieden waren Sie in der letzten Woche mit dem Folgenden:">
				>
				["at9006"] = <
					text = <"Wenn Sie an Ihre Brust denken, wie zufrieden oder unzufrieden waren Sie in der letzten Woche mit dem Folgenden:">
					description = <"Wenn Sie an Ihre Brust denken, wie zufrieden oder unzufrieden waren Sie in der letzten Woche mit dem Folgenden:">
				>
				["at9007"] = <
					text = <"Wenn Sie in beiden Brüsten Implantate haben, denken Sie bei der Beantwortung der Fragen an die Brust, mit der Sie weniger zufrieden sind.  Wie zufrieden waren Sie in der letzten Woche mit dem Folgenden:">
					description = <"Wenn Sie in beiden Brüsten Implantate haben, denken Sie bei der Beantwortung der Fragen an die Brust, mit der Sie weniger zufrieden sind.
Wie zufrieden waren Sie in der letzten Woche mit dem Folgenden:">
				>
				["at9009"] = <
					text = <"Wie zufrieden waren Sie mit den Informationen, die Sie von Ihrem/Ihrer Chirurgen/Chirurgin zu folgenden Dingen erhalten haben:">
					description = <"Wie zufrieden waren Sie mit den Informationen, die Sie von Ihrem/Ihrer Chirurgen/Chirurgin zu folgenden Dingen erhalten haben:">
				>
				["at9010"] = <
					text = <"In den folgenden Fragen geht es um die Mitarbeiter in der Verwaltung (z.B. Sekretariat).  Hatten Sie das Gefühl, dass sie:">
					description = <"In den folgenden Fragen geht es um die Mitarbeiter in der Verwaltung (z.B. Sekretariat).
Hatten Sie das Gefühl, dass sie:">
				>
				["at9012"] = <
