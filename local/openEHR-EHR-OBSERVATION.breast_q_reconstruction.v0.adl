					text = <"Con il tuo seno in mente, nella settimana scorsa, quanto soddisfatta o insoddisfatta ti sei sentita riguardo a:">
					description = <"Con il tuo seno in mente, nella settimana scorsa, quanto soddisfatta o insoddisfatta ti sei sentita riguardo a:">
				>
