													3|[local::at2089]
												}
											}
											ELEMENT[at2090] occurrences matches {0..1} matches {    -- Pulling in your breast area?
												value matches {
													1|[local::at2091],
													2|[local::at2092],
													3|[local::at2093]
												}
											}
											ELEMENT[at2094] occurrences matches {0..1} matches {    -- Nagging feeling in your breast area?
												value matches {
													1|[local::at2095],
													2|[local::at2096],
													3|[local::at2097]
												}
											}
											ELEMENT[at2098] occurrences matches {0..1} matches {    -- Tenderness in your breast area?
												value matches {
													1|[local::at2099],
													2|[local::at2100],
													3|[local::at2101]
												}
											}
											ELEMENT[at2102] occurrences matches {0..1} matches {    -- Sharp pains in your breast area?
												value matches {
													1|[local::at2103],
													2|[local::at2104],
													3|[local::at2105]
												}
											}
											ELEMENT[at2106] occurrences matches {0..1} matches {    -- Aching feeling in your breast area?
												value matches {
													1|[local::at2107],
													2|[local::at2108],
													3|[local::at2109]
												}
											}
											ELEMENT[at2110] occurrences matches {0..1} matches {    -- Pain in the muscles of your chest?
												value matches {
													1|[local::at2111],
													2|[local::at2112],
													3|[local::at2113]
												}
											}
											ELEMENT[at2114] occurrences matches {0..1} matches {    -- Throbbing feeling in your breast area?
												value matches {
													1|[local::at2115],
													2|[local::at2116],
													3|[local::at2117]
												}
											}
											ELEMENT[at2118] occurrences matches {0..1} matches {    -- Difficulty lifting or moving your arms?
												value matches {
													1|[local::at2119],
													2|[local::at2120],
													3|[local::at2121]
												}
											}
											ELEMENT[at2122] occurrences matches {0..1} matches {    -- Difficulty sleeping because of discomfort in your breast area?
												value matches {
													1|[local::at2123],
													2|[local::at2124],
													3|[local::at2125]
												}
											}
											ELEMENT[at2126] occurrences matches {0..1} matches {    -- Tightness in your breast area?
												value matches {
													1|[local::at2127],
													2|[local::at2128],
													3|[local::at2129]
												}
											}
											ELEMENT[at2130] occurrences matches {0..1} matches {    -- Pulling in your breast area?
												value matches {
													1|[local::at2131],
													2|[local::at2132],
													3|[local::at2133]
												}
											}
											ELEMENT[at2134] occurrences matches {0..1} matches {    -- Nagging feeling in your breast area?
												value matches {
													1|[local::at2135],
													2|[local::at2136],
													3|[local::at2137]
												}
											}
											ELEMENT[at2138] occurrences matches {0..1} matches {    -- Tenderness in your breast area?
												value matches {
													1|[local::at2139],
													2|[local::at2140],
													3|[local::at2141]
												}
											}
											ELEMENT[at2142] occurrences matches {0..1} matches {    -- Sharp pains in your breast area?
												value matches {
													1|[local::at2143],
													2|[local::at2144],
													3|[local::at2145]
												}
											}
											ELEMENT[at2146] occurrences matches {0..1} matches {    -- Aching feeling in your breast area?
												value matches {
													1|[local::at2147],
													2|[local::at2148],
													3|[local::at2149]
												}
											}
										}
									}
									CLUSTER[at9002] occurrences matches {0..1} matches {    -- With your breast area in mind, in the past week, how often have you felt:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2150] occurrences matches {0..1} matches {    -- Confident in a social setting?
												value matches {
													1|[local::at2151],
													2|[local::at2152],
													3|[local::at2153],
													4|[local::at2154],
													5|[local::at2155]
												}
											}
											ELEMENT[at2156] occurrences matches {0..1} matches {    -- Attractive?
												value matches {
													1|[local::at2157],
													2|[local::at2158],
													3|[local::at2159],
													4|[local::at2160],
													5|[local::at2161]
												}
											}
											ELEMENT[at2162] occurrences matches {0..1} matches {    -- Emotionally able to do the things that you want to do?
												value matches {
													1|[local::at2163],
													2|[local::at2164],
													3|[local::at2165],
													4|[local::at2166],
													5|[local::at2167]
												}
											}
											ELEMENT[at2168] occurrences matches {0..1} matches {    -- Emotionally healthy?
												value matches {
													1|[local::at2169],
													2|[local::at2170],
													3|[local::at2171],
													4|[local::at2172],
													5|[local::at2173]
												}
											}
											ELEMENT[at2174] occurrences matches {0..1} matches {    -- Of equal worth to other women?
												value matches {
													1|[local::at2175],
													2|[local::at2176],
													3|[local::at2177],
													4|[local::at2178],
													5|[local::at2179]
												}
											}
											ELEMENT[at2180] occurrences matches {0..1} matches {    -- Self-confident?
												value matches {
													1|[local::at2181],
													2|[local::at2182],
													3|[local::at2183],
													4|[local::at2184],
													5|[local::at2185]
												}
											}
											ELEMENT[at2186] occurrences matches {0..1} matches {    -- Feminine in your clothes?
												value matches {
													1|[local::at2187],
													2|[local::at2188],
													3|[local::at2189],
													4|[local::at2190],
													5|[local::at2191]
												}
											}
											ELEMENT[at2192] occurrences matches {0..1} matches {    -- Accepting of your body?
												value matches {
													1|[local::at2193],
													2|[local::at2194],
													3|[local::at2195],
													4|[local::at2196],
													5|[local::at2197]
												}
											}
											ELEMENT[at2198] occurrences matches {0..1} matches {    -- Normal?
												value matches {
													1|[local::at2199],
													2|[local::at2200],
													3|[local::at2201],
													4|[local::at2202],
													5|[local::at2203]
												}
											}
											ELEMENT[at2204] occurrences matches {0..1} matches {    -- Like other women?
												value matches {
													1|[local::at2205],
													2|[local::at2206],
													3|[local::at2207],
													4|[local::at2208],
													5|[local::at2209]
												}
											}
										}
									}
									CLUSTER[at9003] occurrences matches {0..1} matches {    -- If you have had radiation on both breasts, answer these questions thinking of the breast you are least satisfied with.  With your radiated breast(s) in mind, in the past week, how much have you been bothered by:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2210] occurrences matches {0..1} matches {    -- Your radiated breast skin looking different (e.g., too dark or too light)?
												value matches {
													1|[local::at2211],
													2|[local::at2212],
													3|[local::at2213]
												}
											}
											ELEMENT[at2214] occurrences matches {0..1} matches {    -- Marks on your breast skin caused by radiation (e.g., small visible blood vessels)?
												value matches {
													1|[local::at2215],
													2|[local::at2216],
													3|[local::at2217]
												}
											}
											ELEMENT[at2218] occurrences matches {0..1} matches {    -- Your radiated breast skin feeling dry?
												value matches {
													1|[local::at2219],
													2|[local::at2220],
													3|[local::at2221]
												}
											}
											ELEMENT[at2222] occurrences matches {0..1} matches {    -- Your radiated breast skin feeling sore (sensitive) when touched (e.g., changes in water temperature when you bathe/shower)?
												value matches {
													1|[local::at2223],
													2|[local::at2224],
													3|[local::at2225]
												}
											}
											ELEMENT[at2226] occurrences matches {0..1} matches {    -- Your radiated breast skin feeling unnaturally thick (rough, tough) when you touch it?
												value matches {
													1|[local::at2227],
													2|[local::at2228],
													3|[local::at2229]
												}
											}
											ELEMENT[at2230] occurrences matches {0..1} matches {    -- Your radiated breast skin feeling irritated by clothing that you wear?
												value matches {
													1|[local::at2231],
													2|[local::at2232],
													3|[local::at2233]
												}
											}
										}
									}
									CLUSTER[at9004] occurrences matches {0..1} matches {    -- In the past week, how satisfied or dissatisfied have you been with:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at2234] occurrences matches {0..1} matches {    -- How your abdomen (tummy area) looks when unclothed?
												value matches {
													1|[local::at2235],
													2|[local::at2236],
													3|[local::at2237],
													4|[local::at2238]
												}
											}
											ELEMENT[at2239] occurrences matches {0..1} matches {    -- The position of your navel (belly button)?
												value matches {
													1|[local::at2240],
													2|[local::at2241],
													3|[local::at2242],
													4|[local::at2243]
												}
											}
											ELEMENT[at2244] occurrences matches {0..1} matches {    -- How your abdominal scars look?
												value matches {
													1|[local::at2245],
													2|[local::at2246],
													3|[local::at2247],
													4|[local::at2248]
												}
											}
