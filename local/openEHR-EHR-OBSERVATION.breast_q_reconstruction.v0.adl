													2|[local::at2076],
													3|[local::at2077]
												}
											}
											ELEMENT[at2078] occurrences matches {0..1} matches {    -- Difficulty lifting or moving your arms?
												value matches {
													1|[local::at2079],
													2|[local::at2080],
													3|[local::at2081]
												}
											}
											ELEMENT[at2082] occurrences matches {0..1} matches {    -- Difficulty sleeping because of discomfort in your breast area?
												value matches {
