					text = <"Nell’ultima settimana quanto spesso hai provato:">
					description = <"Nell’ultima settimana quanto spesso hai provato:">
				>
				["at9002"] = <
					text = <"Pensando al(i) tuo(i) seno(i), nell’ultima settimana quanto spesso ti sei sentita:">
					description = <"Pensando al(i) tuo(i) seno(i), nell’ultima settimana quanto spesso ti sei sentita:">
				>
				["at9003"] = <
					text = <"Se sei stata sottoposta a radioterapia su entrambi i seni, rispondi a queste domande pensando al seno di cui sei meno soddisfatta. Avendo in mente il seno/i irradiato/i, nella scorsa settimana, quanto ti ha infastidito:">
					description = <"Se sei stata sottoposta a radioterapia su entrambi i seni, rispondi a queste domande pensando al seno di cui sei meno soddisfatta. Avendo in mente il seno/i irradiato/i, nella scorsa settimana, quanto ti ha infastidito:">
				>
				["at9004"] = <
					text = <"Le seguenti domande riguardano la ricostruzione mammaria eseguita con lembo TRAM o DIEP (ricostruzione mammaria usando tessuto adiposo e cute dalla tua regione addominale). Nell’ultima settimana, pensando alla regione addominale (pancia), quanto spesso hai provato:">
					description = <"Le seguenti domande riguardano la ricostruzione mammaria eseguita con lembo TRAM o DIEP (ricostruzione mammaria usando tessuto adiposo e cute dalla tua regione addominale). Nell’ultima settimana, pensando alla regione addominale (pancia), quanto spesso hai provato:">
				>
				["at9005"] = <
					text = <"Se hai avuto una mastectomia e la ricostruzione di entrambi i seni, rispondi a queste domande pensando al seno per cui ti senti meno soddisfatta. Con il tuo seno in mente, nella settimana scorsa, quanto soddisfatta o insoddisfatta ti sei sentita riguardo a:">
					description = <"Se hai avuto una mastectomia e la ricostruzione di entrambi i seni, rispondi a queste domande pensando al seno per cui ti senti meno soddisfatta. Con il tuo seno in mente, nella settimana scorsa, quanto soddisfatta o insoddisfatta ti sei sentita riguardo a:">
				>
