													1|[local::at2071],
													2|[local::at2072],
													3|[local::at2073]
												}
											}
											ELEMENT[at2074] occurrences matches {0..1} matches {    -- Swelling of the arm (lymphedema) on the side(s) that you had your breast surgery?
