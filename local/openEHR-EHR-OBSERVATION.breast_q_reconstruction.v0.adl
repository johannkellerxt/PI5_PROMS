				["at9000"] = <
					text = <"Wenn Sie an Ihren Abdomen (Bauchbereich) denken, wie oft hatten Sie in der letzten Woche:">
					description = <"Wenn Sie an Ihren Abdomen (Bauchbereich) denken, wie oft hatten Sie in der letzten Woche:">
