		["fr"] = <
			items = <
				["at0000"] = <
					text = <"iief5_shittymeta">
					description = <"L'International Index of Erectile Function-5 (IIEF-5), également appelé Sexual Health Inventory for Men (SHIM), est un questionnaire validé rapporté par le patient utilisé pour évaluer la fonction érectile et dépister la dysfonction érectile.">
				>
				["at0004"] = <
					text = <"A quel point étiez-vous sûr de pouvoir avoir une érection et de la maintenir ?">
					description = <"">
				>
				["at0005"] = <
					text = <"Pas sûr du tout">
					description = <"">
				>
				["at0006"] = <
					text = <"Pas très sûr">
					description = <"">
				>
				["at0007"] = <
					text = <"Moyennement sûr">
					description = <"">
				>
				["at0008"] = <
					text = <"Sûr">
					description = <"">
				>
				["at0009"] = <
					text = <"Très sûr">
					description = <"">
				>
				["at0010"] = <
					text = <"Lorsque vous avez eu des érections à la suite de stimulations sexuelles, avec quelle fréquence votre  pénis a-t-il été suffisamment rigide (dur) pour permettre la pénétration ?">
					description = <"">
				>
				["at0012"] = <
					text = <"Presque jamais ou jamais">
					description = <"">
				>
				["at0013"] = <
					text = <"Rarement (beaucoup moins que la moitié du temps)">
					description = <"">
				>
				["at0014"] = <
					text = <"Quelquefois (environ la moitié du temps)">
					description = <"">
				>
				["at0015"] = <
					text = <"La plupart du temps (beaucoup plus que la moitié du temps)">
					description = <"">
				>
				["at0016"] = <
					text = <"Presque tout le temps ou tout le temps">
					description = <"">
				>
				["at0017"] = <
					text = <"Lorsque vous avez essayé d'avoir des rapports sexuels, avec quelle fréquence avez-vous pu rester  en érection après avoir pénétré votre partenaire ?">
					description = <"">
				>
				["at0019"] = <
					text = <"Presque jamais ou jamais">
					description = <"">
				>
				["at0020"] = <
					text = <"Rarement (beaucoup moins que la moitié du temps)">
					description = <"">
				>
				["at0021"] = <
					text = <"Quelquefois (environ la moitié du temps)">
					description = <"">
				>
				["at0022"] = <
					text = <"La plupart du temps (beaucoup plus que la moitié du temps)">
					description = <"">
				>
				["at0023"] = <
					text = <"Presque tout le temps ou tout le temps">
					description = <"">
				>
				["at0024"] = <
					text = <"Pendant vos rapports sexuels, à quel point vous a-t-il été difficile de rester en érection jusqu'à la fin  de ces rapports ?">
					description = <"">
				>
				["at0026"] = <
					text = <"Extrêmement difficile">
					description = <"">
				>
				["at0027"] = <
					text = <"Très difficile">
					description = <"">
				>
				["at0028"] = <
					text = <"Difficile">
					description = <"">
				>
				["at0029"] = <
					text = <"Un peu difficile">
					description = <"">
				>
				["at0030"] = <
					text = <"Pas difficile">
					description = <"">
				>
				["at0031"] = <
					text = <"Lorsque vous avez essayé d'avoir des rapports sexuels, avec quelle fréquence en avez-vous été  satisfait ?">
					description = <"">
				>
				["at0033"] = <
					text = <"Presque jamais ou jamais">
					description = <"">
				>
				["at0034"] = <
					text = <"Rarement (beaucoup moins que la moitié du temps)">
